// ------------------------
// Libraries
// ------------------------
#include <ESP32Servo.h>

// ------------------------
// Variables that don't change
// ------------------------
int sensorPin = 15;
int btnPin = 18;
int drivePin = 19;
int dropPin = 21;
int ledPIN = 2;

int stop = 90;
int fwd = 180;
int rev = 0;

Servo driveServo;
Servo dropServo;

// ------------------------
// Variables that can change
// ------------------------
int btnState;
int sensorState;
int toggle = 0;

// ------------------------
// Setup
// ------------------------
void setup()
{
  pinMode(ledPIN, OUTPUT);
  pinMode(sensorPin, INPUT);
  pinMode(btnPin, INPUT);

  driveServo.setPeriodHertz(50);
  driveServo.attach(drivePin, 500, 2400);

  dropServo.setPeriodHertz(50);
  dropServo.attach(dropPin, 500, 2400);

  Serial.begin(9600);
}

// ------------------------
// Main loop
// ------------------------
void loop()
{
  btnState = digitalRead(btnPin);
  sensorState = digitalRead(sensorPin);

  // ------------------------
  // Button toggle (simple edge detect)
  // ------------------------
  if (btnState == HIGH)
  {
    toggle = !toggle;
    delay(150);
  }

  // ------------------------
  // Mode control
  // ------------------------
  if (toggle == 1)
  {
    run();
  }
  else
  {
    standby();
  }
}

// ------------------------
// Run mode
// ------------------------
void run()
{
  Serial.println("Run Mode");

  digitalWrite(ledPIN, HIGH);
  driveServo.write(fwd);

  if (sensorState == HIGH)
  {
    drop();
  }
}

// ------------------------
// Standby mode
// ------------------------
void standby()
{
  Serial.println("Standby Mode");

  digitalWrite(ledPIN, LOW);
  driveServo.write(stop);
}

// ------------------------
// Drop action
// ------------------------
void drop()
{
  Serial.println("DROP");

  dropServo.write(90);
}