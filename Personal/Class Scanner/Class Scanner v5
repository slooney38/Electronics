// ======================================================
// ATTENDANCE REPORT
// Memory-efficient version: no large per-student report array.
// For each OUT record, scan forward for that student's next IN.
// ======================================================

bool parseLogLine(String line, String &timestamp, String &id,
                  String &first, String &last, String &action,
                  String &reason) {
  line.trim();
  if (line.length() == 0) return false;

  int p1 = line.indexOf(',');
  if (p1 < 0) return false;
  int p2 = line.indexOf(',', p1 + 1);
  if (p2 < 0) return false;
  int p3 = line.indexOf(',', p2 + 1);
  if (p3 < 0) return false;
  int p4 = line.indexOf(',', p3 + 1);
  if (p4 < 0) return false;

  timestamp = line.substring(0, p1);
  id = line.substring(p1 + 1, p2);
  first = line.substring(p2 + 1, p3);
  last = line.substring(p3 + 1, p4);

  String tail = line.substring(p4 + 1);
  int p5 = tail.indexOf(',');
  action = (p5 >= 0) ? tail.substring(0, p5) : tail;
  reason = (p5 >= 0) ? tail.substring(p5 + 1) : "Washroom";

  timestamp.trim();
  id.trim();
  first.trim();
  last.trim();
  action.trim();
  reason.trim();

  return action == "OUT" || action == "IN";
}

void sendReportRow(const String &id, const String &first,
                   const String &last, const String &timeOut,
                   const String &timeIn, long minutesOut,
                   const String &reason) {
  String row;
  row.reserve(180);
  row += id; row += ",";
  row += first; row += ",";
  row += last; row += ",";
  row += timeOut; row += ",";
  row += timeIn; row += ",";
  row += String(minutesOut); row += ",";
  row += reason; row += "\r\n";
  server.sendContent(row);
}

void handleReport() {
  File input = SPIFFS.open("/logs.csv", FILE_READ);
  if (!input) {
    server.send(404, "text/plain", "No logs found");
    return;
  }

  server.sendHeader(
    "Content-Disposition",
    "attachment; filename=attendance_report.csv"
  );
  server.setContentLength(CONTENT_LENGTH_UNKNOWN);
  server.send(200, "text/csv; charset=utf-8", "");
  server.sendContent(
    "Pupil#,UsualFirst,UsualLast,TimeOut,TimeIn,MinutesOut,Reason\r\n"
  );

  input.readStringUntil('\n');

  while (input.available()) {
    String line = input.readStringUntil('\n');
    String timestamp, id, first, last, action, reason;

    if (!parseLogLine(line, timestamp, id, first, last, action, reason)) {
      delay(0);
      continue;
    }

    if (action != "OUT") {
      delay(0);
      continue;
    }

    // Find the next IN for this student without storing a large array in RAM.
    const size_t nextPosition = input.position();
    String timeIn = "";
    bool foundIn = false;

    File lookAhead = SPIFFS.open("/logs.csv", FILE_READ);
    if (lookAhead) {
      lookAhead.readStringUntil('\n');
      if (nextPosition <= lookAhead.size()) {
        lookAhead.seek(nextPosition, SeekSet);
        while (lookAhead.available()) {
          String futureLine = lookAhead.readStringUntil('\n');
          String t2, id2, first2, last2, action2, reason2;

          if (parseLogLine(futureLine, t2, id2, first2, last2,
                           action2, reason2) &&
              id2 == id && action2 == "IN") {
            timeIn = t2;
            foundIn = true;
            break;
          }
          delay(0);
        }
      }
      lookAhead.close();
    }

    long mins = 0;
    if (foundIn) {
      mins = minutesBetween(timestamp, timeIn);
    } else {
      time_t start = timestampToEpoch(timestamp);
      time_t now = time(nullptr);
      if (start > 0 && now >= start) mins = (long)(now - start) / 60L;
    }

    sendReportRow(id, first, last, timestamp, timeIn, mins, reason);
    delay(0);
  }

  input.close();
  server.sendContent("");
}

