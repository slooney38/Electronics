// ======================================================
// SETUP
// ======================================================

void setup() {
  Serial.begin(115200);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  for (int led = 0; led < LED_COUNT; led++) {
    ledStudentIndex[led] = -1;
  }

  ledStrip.begin();
  settingsPrefs.begin("classscan", true);
  reasonTimeoutMs = settingsPrefs.getULong("timeout", 3000);
  if (reasonTimeoutMs < 1000 || reasonTimeoutMs > 10000) reasonTimeoutMs = 3000;
  ledBrightness = settingsPrefs.getUChar("brightness", 50);
  scanConfirmationSeconds = settingsPrefs.getUChar("scanconfirm", 2);
  if (scanConfirmationSeconds > 5) scanConfirmationSeconds = 2;
  settingsPrefs.end();

  ledStrip.setBrightness(ledBrightness);
  ledStrip.clear();
  ledStrip.show();

  Wire.begin(21, 22);

  if (oled.begin(0x3C, true)) {
    oledReady = true;
    oled.clearDisplay();
    oled.setTextColor(SH110X_WHITE);
    oled.setTextSize(1);
    oled.setCursor(0, 0);
    oled.println("Class Scanner");
    oled.println("Starting...");
    oled.display();

    Serial.println("SH1106 OLED ready at 0x3C");
  } else {
    Serial.println("SH1106 OLED not found at 0x3C");
  }

  scanner.begin(9600, SERIAL_8N1, 16, 17);

  if (!SPIFFS.begin(true)) {
    Serial.println("SPIFFS mount failed");
    return;
  }

  initLogs();
  loadStudents();

  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);

  Serial.print("AP IP: ");
  Serial.println(WiFi.softAPIP());

  WiFi.begin(SCHOOL_SSID, SCHOOL_PASS);

  Serial.println("Connecting to school WiFi...");
  unsigned long started = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - started < 15000) {
    delay(250);
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("School WiFi IP: ");
    Serial.println(WiFi.localIP());

    configTime(-8 * 3600, 3600,
               "pool.ntp.org", "time.nist.gov");

    struct tm ti;

    if (getLocalTime(&ti, 10000)) {
      Serial.println("Time synchronized");
    } else {
      Serial.println("NTP not available yet");
    }
  } else {
    Serial.println("School WiFi unavailable; AP is still active");
  }

  restoreAttendanceState();

  reasonMenuVisible = false;
  updateOledDisplay(true);
  lastOledUpdate = millis();

  updateLedStrip();

  server.on("/", HTTP_GET, handleRoot);
  server.on("/upload", HTTP_GET, showUploadPage);
  server.on("/students", HTTP_GET, showStudents);
  server.on("/student-management", HTTP_GET, showStudentManagement);
  server.on("/attendance-reports", HTTP_GET, showAttendanceReports);
  server.on("/logs", HTTP_GET, handleLogs);
  server.on("/report", HTTP_GET, handleReport);
  server.on("/options", HTTP_GET, showOptions);
  server.on("/options", HTTP_POST, saveOptions);
  server.on("/clearstudents", HTTP_GET, showClearStudents);
  server.on("/clearstudents", HTTP_POST, doClearStudents);
  server.on("/clearlogs", HTTP_GET, showClearLogs);
  server.on("/clearlogs", HTTP_POST, doClearLogs);

  server.on(
    "/upload",
    HTTP_POST,
    handleUploadComplete,
    handleUploadData
  );

  server.begin();

  Serial.println("Web server ready");
  Serial.println("Open http://192.168.4.1/");
}

// ======================================================
// MAIN LOOP
// ======================================================

void loop() {
  server.handleClient();
  handleReasonButton();
  updateOledDisplay();

  static unsigned long lastLedUpdate = 0;

  if (millis() - lastLedUpdate >= 100) {
    lastLedUpdate = millis();
    updateLedStrip();
  }

  if (scanner.available()) {
    String code = scanner.readStringUntil('\n');
    code.trim();
    if (code.length() == 0) return;

    // Do not accept another scan while a student is choosing a reason.
    if (pendingOutStudentIndex >= 0) {
      Serial.println("Choose a reason and hold the button to confirm first.");
      return;
    }

    Student* s = findStudent(code);
    if (!s) {
      lastScan = "Unknown Student: " + code;
      lastTime = getTimestamp();
      Serial.println(lastScan);
      scanMessage = "Unknown student";
      scanMessageUntil = millis() + 2000UL;
      updateOledDisplay(true);
      return;
    }

    if (!s->out) {
      // Student is leaving: ask for a reason before recording the OUT event.
      pendingOutStudentIndex = (int)(s - students);
      selectedReason = -1;  // No choice until the button is tapped.
      reasonSelectionDeadline = 0;
      scanStudentName = s->first + " " + s->last;
      scanStudentId = s->id;
      scanMessage = "";
      waitingToShowReason = scanConfirmationSeconds > 0;
      scanMessageUntil = waitingToShowReason
        ? millis() + (unsigned long)scanConfirmationSeconds * 1000UL : 0;
      reasonMenuVisible = !waitingToShowReason;
      lastOledUpdate = millis();
      if (waitingToShowReason) showScanMessage();
      else showReasonMenu();
      Serial.print("Reason required for: ");
      Serial.println(s->first + " " + s->last);
      return;
    }

    // Student is returning IN; no reason prompt is needed.
    String timestamp = getTimestamp();
    s->out = false;
    String reasonForLog = s->outReason;
    s->outTime = "";
    logEvent(s, "IN", timestamp, reasonForLog);

    lastScan = s->first + " " + s->last + " (IN)";
    lastTime = timestamp;
    Serial.println(lastScan);

    scanMessage = "IN recorded";
    scanStudentName = s->first + " " + s->last;
    scanStudentId = s->id;
    scanMessageUntil = scanConfirmationSeconds > 0 ? millis() + (unsigned long)scanConfirmationSeconds * 1000UL : 0;
    reasonMenuVisible = false;
    updateOledDisplay(true);
    updateLedStrip();
  }
}
