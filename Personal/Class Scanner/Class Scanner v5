void finishPendingOut() {
  if (pendingOutStudentIndex < 0 ||
      pendingOutStudentIndex >= studentCount) return;
  if (selectedReason < 0 || selectedReason > REASON_COUNT) return;

  // Choosing Back cancels this pending checkout and returns to Students Out.
  if (selectedReason == REASON_COUNT) {
    pendingOutStudentIndex = -1;
    selectedReason = -1;
    reasonSelectionDeadline = 0;
    reasonMenuVisible = false;
    waitingToShowReason = false;
    scanMessageUntil = 0;
    lastScan = "Checkout cancelled";
    lastTime = getTimestamp();
    updateOledDisplay(true);
    return;
  }

  Student* s = &students[pendingOutStudentIndex];
  String timestamp = getTimestamp();
  s->out = true;
  s->outTime = timestamp;
  s->outReason = String(REASONS[selectedReason]);
  logEvent(s, "OUT", timestamp, s->outReason);

  lastScan = s->first + " " + s->last + " (OUT)";
  lastTime = timestamp;
  Serial.println(lastScan);

  // After the reason is confirmed, go straight to the Students Out list.
  // The name/ID confirmation already appeared before the reason menu.
  scanMessage = "OUT recorded";
  scanStudentName = s->first + " " + s->last;
  scanStudentId = s->id;
  scanMessageUntil = 0;
  pendingOutStudentIndex = -1;
  reasonSelectionDeadline = 0;
  reasonMenuVisible = false;
  waitingToShowReason = false;
  updateOledDisplay(true);
  updateLedStrip();
}

void handleReasonButton() {
  bool reading = digitalRead(BUTTON_PIN);

  if (reading != buttonLastReading) {
    buttonLastChange = millis();
    buttonLastReading = reading;
  }

  if (millis() - buttonLastChange < BUTTON_DEBOUNCE_MS ||
      reading == buttonStableState) return;

  buttonStableState = reading;

  // A short press is registered on release. Long presses also count as one tap.
  if (buttonStableState == HIGH && pendingOutStudentIndex >= 0 && !waitingToShowReason) {
    if (selectedReason < 0) {
      selectedReason = 0;
    } else {
      // Cycle through both reasons and the Back option.
      selectedReason = (selectedReason + 1) % (REASON_COUNT + 1);
    }

    // Give the user three seconds after the most recent selection/change.
    reasonSelectionDeadline = millis() + reasonTimeoutMs;
    showReasonMenu();
    lastOledUpdate = millis();
  } else if (buttonStableState == HIGH && pendingOutStudentIndex < 0) {
    reasonMenuVisible = false;
    updateOledDisplay(true);
  }
}

void updateOledDisplay(bool force) {
  if (!oledReady) return;

  unsigned long nowMs = millis();

  // For an OUT scan, show the student's name and ID first, then the reason menu.
  if (pendingOutStudentIndex >= 0 && waitingToShowReason) {
    if (scanConfirmationSeconds > 0 && scanMessageUntil != 0 &&
        (long)(nowMs - scanMessageUntil) < 0) {
      if (force || nowMs - lastOledUpdate >= OLED_REFRESH_MS) {
        lastOledUpdate = nowMs;
        showScanMessage();
      }
      return;
    }
    waitingToShowReason = false;
    scanMessageUntil = 0;
    reasonMenuVisible = true;
    lastOledUpdate = nowMs;
    showReasonMenu();
    return;
  }

  // A selected reason is automatically recorded after the visible countdown.
  if (pendingOutStudentIndex >= 0) {
    if (selectedReason >= 0 && reasonSelectionDeadline != 0 &&
        (long)(nowMs - reasonSelectionDeadline) >= 0) {
      finishPendingOut();
      return;
    }
    // Refresh the progress bar frequently so it visibly advances smoothly.
    if (force || nowMs - lastOledUpdate >= 100UL) {
      lastOledUpdate = nowMs;
      showReasonMenu();
    }
    return;
  }

  if (scanMessageUntil != 0 && nowMs < scanMessageUntil) {
    if (force || nowMs - lastOledUpdate >= OLED_REFRESH_MS) {
      lastOledUpdate = nowMs;
      showScanMessage();
    }
    return;
  }

  if (scanMessageUntil != 0 && nowMs >= scanMessageUntil) {
    scanMessageUntil = 0;
  }

  if (!force && nowMs - lastOledUpdate < OLED_REFRESH_MS) return;
  lastOledUpdate = nowMs;

  int outCount = 0;
  for (int i = 0; i < studentCount; i++) {
    if (students[i].out) outCount++;
  }

  oled.clearDisplay();
  oled.setTextColor(SH110X_WHITE);
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.print("STUDENTS OUT: ");
  oled.print(outCount);
  oled.drawLine(0, 10, 127, 10, SH110X_WHITE);

  if (outCount == 0) {
    oled.setCursor(0, 25);
    oled.print("Scan Student ID");
    oled.setCursor(0, 40);
    oled.print("to begin");
    oled.display();
    return;
  }

  const int namesPerPage = 4;
  int pageCount = (outCount + namesPerPage - 1) / namesPerPage;
  int page = (nowMs / OLED_PAGE_MS) % pageCount;
  int firstOutIndex = page * namesPerPage;
  int currentOutIndex = 0;
  int displayed = 0;
  time_t nowEpoch = time(nullptr);

  for (int i = 0; i < studentCount && displayed < namesPerPage; i++) {
    if (!students[i].out) continue;
    if (currentOutIndex >= firstOutIndex) {
      String name = students[i].first + " " + students[i].last;
      time_t outEpoch = timestampToEpoch(students[i].outTime);
      long elapsedMinutes =
        (outEpoch > 0 && nowEpoch >= outEpoch)
        ? (long)(nowEpoch - outEpoch) / 60L : 0L;
      String duration = String(elapsedMinutes) + "m";
      int maxNameLength = 21 - duration.length() - 2;
      if (maxNameLength < 1) maxNameLength = 1;
      if ((int)name.length() > maxNameLength) name = name.substring(0, maxNameLength);
      oled.setCursor(0, 13 + displayed * 12);
      oled.print(name);
      oled.print("  ");
      oled.print(duration);
      displayed++;
    }
    currentOutIndex++;
  }

  if (pageCount > 1) {
    oled.setCursor(94, 55);
    oled.print(String(page + 1) + "/" + String(pageCount));
  }
  oled.display();
}

// ======================================================
// TIME FUNCTIONS
// ======================================================

String getTimestamp() {
  struct tm ti;

  if (!getLocalTime(&ti, 1000)) {
    return "No Time";
  }

  char buf[24];
  strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &ti);
  return String(buf);
}

String getClockTime(String ts) {
  if (ts.length() >= 19) return ts.substring(11, 19);
  return "--:--:--";
}

time_t timestampToEpoch(String ts) {
  int y, mo, d, h, mi, s;

  if (sscanf(ts.c_str(), "%d-%d-%d %d:%d:%d",
             &y, &mo, &d, &h, &mi, &s) != 6) {
    return 0;
  }

  struct tm ti = {};
  ti.tm_year = y - 1900;
  ti.tm_mon = mo - 1;
  ti.tm_mday = d;
  ti.tm_hour = h;
  ti.tm_min = mi;
  ti.tm_sec = s;
  ti.tm_isdst = -1;

  return mktime(&ti);
}

String formatDuration(long seconds) {
  if (seconds < 0) seconds = 0;

  long minutes = seconds / 60;
  long hours = minutes / 60;
  minutes %= 60;

  if (hours > 0) {
    return String(hours) + " hr " + String(minutes) + " min";
  }

  return String(minutes) + " min";
}

long minutesBetween(String start, String finish) {
  time_t a = timestampToEpoch(start);
  time_t b = timestampToEpoch(finish);

  if (a == 0 || b == 0 || b < a) return 0;
  return (long)(b - a) / 60;
}

// ======================================================
// LED STRIP
// Green: under 5 min
// Orange: 5 to under 10 min
// Solid red: 10 to under 15 min
// Blinking red: 15 min or longer
// ======================================================

int findLedForStudent(int studentIndex) {
  for (int led = 0; led < LED_COUNT; led++) {
    if (ledStudentIndex[led] == studentIndex) return led;
  }

  return -1;
}

void updateLedAssignments() {
  for (int led = 0; led < LED_COUNT; led++) {
    int idx = ledStudentIndex[led];

    if (idx < 0 || idx >= studentCount || !students[idx].out) {
      ledStudentIndex[led] = -1;
    }
  }

  for (int i = 0; i < studentCount; i++) {
    if (!students[i].out || findLedForStudent(i) >= 0) continue;

    for (int led = 0; led < LED_COUNT; led++) {
      if (ledStudentIndex[led] < 0) {
        ledStudentIndex[led] = i;
        break;
      }
    }
  }
}

void updateLedStrip() {
  updateLedAssignments();
  time_t now = time(nullptr);

  for (int led = 0; led < LED_COUNT; led++) {
    uint32_t color = ledStrip.Color(0, 0, 0);
    int idx = ledStudentIndex[led];

    if (idx >= 0 && idx < studentCount && students[idx].out) {
      time_t start = timestampToEpoch(students[idx].outTime);

      long elapsedSeconds =
        (start > 0 && now >= start) ? (long)(now - start) : 0;

      if (elapsedSeconds < 5L * 60L) {
        color = ledStrip.Color(0, 255, 0);
      } else if (elapsedSeconds < 10L * 60L) {
        color = ledStrip.Color(255, 70, 0);
      } else if (elapsedSeconds < 15L * 60L) {
        color = ledStrip.Color(255, 0, 0);
      } else {
        color = (millis() % 1000UL < 500UL)
                ? ledStrip.Color(255, 0, 0)
                : ledStrip.Color(0, 0, 0);
      }
    }

    ledStrip.setPixelColor(led, color);
  }

  ledStrip.show();
}

// ======================================================
// STUDENT LOOKUP AND CSV LOADING
// ======================================================

Student* findStudent(String id) {
  id.trim();

  for (int i = 0; i < studentCount; i++) {
    if (students[i].id == id) return &students[i];
  }

  return nullptr;
}

void loadStudents() {
  studentCount = 0;

  if (!SPIFFS.exists("/students.csv")) {
    Serial.println("No students.csv found");
    return;
  }

  File f = SPIFFS.open("/students.csv", FILE_READ);
  if (!f) return;

  f.readStringUntil('\n');

  while (f.available() && studentCount < MAX_STUDENTS) {
    String line = f.readStringUntil('\n');
    line.trim();

    if (line.length() == 0) continue;

    int p1 = line.indexOf(',');
    int p2 = line.indexOf(',', p1 + 1);

    if (p1 < 0 || p2 < 0) continue;

    String id = line.substring(0, p1);
    String first = line.substring(p1 + 1, p2);
    String last = line.substring(p2 + 1);

    id.trim();
    first.trim();
    last.trim();

    if (id.length() == 0) continue;

    bool duplicate = false;

    for (int i = 0; i < studentCount; i++) {
      if (students[i].id == id) {
        duplicate = true;
        break;
      }
    }

    if (duplicate) continue;

    students[studentCount].id = id;
    students[studentCount].first = first;
    students[studentCount].last = last;
    students[studentCount].out = false;
    students[studentCount].outTime = "";
    students[studentCount].outReason = "";
    studentCount++;
  }

  f.close();

  Serial.print("Students loaded: ");
  Serial.println(studentCount);
}

// ======================================================
// ATTENDANCE LOGS
// ======================================================

void initLogs() {
  if (!SPIFFS.exists("/logs.csv")) {
    File f = SPIFFS.open("/logs.csv", FILE_WRITE);

    if (f) {
      f.println("Timestamp,Pupil#,UsualFirst,UsualLast,Action,Reason");
      f.close();
    }
  }
}

void logEvent(Student* s, String action, String timestamp, String reason) {
  File f = SPIFFS.open("/logs.csv", FILE_APPEND);

  if (!f) {
    Serial.println("ERROR: Cannot write logs.csv");
    return;
  }

  f.print(timestamp);
  f.print(",");
  f.print(s->id);
  f.print(",");
  f.print(s->first);
  f.print(",");
  f.print(s->last);
  f.print(",");
  f.print(action);
  f.print(",");

  if (action == "OUT") {
    f.println(reason);
  } else {
    f.println(s->outReason);
  }

  f.close();
}

void restoreAttendanceState() {
  if (!SPIFFS.exists("/logs.csv")) return;

  File f = SPIFFS.open("/logs.csv", FILE_READ);
  if (!f) return;

  f.readStringUntil('\n');

  while (f.available()) {
    String line = f.readStringUntil('\n');
    line.trim();

    if (line.length() == 0) continue;

    int p1 = line.indexOf(',');
    int p2 = line.indexOf(',', p1 + 1);
    int p3 = line.indexOf(',', p2 + 1);
    int p4 = line.indexOf(',', p3 + 1);

    if (p1 < 0 || p2 < 0 || p3 < 0 || p4 < 0) continue;

    String id = line.substring(p1 + 1, p2);
    String timestamp = line.substring(0, p1);
    String tail = line.substring(p4 + 1);

    int p5 = tail.indexOf(',');
    String action = (p5 >= 0) ? tail.substring(0, p5) : tail;
    String reason = (p5 >= 0) ? tail.substring(p5 + 1) : "Washroom";

    action.trim();
    reason.trim();

    Student* s = findStudent(id);
    if (!s) continue;

    if (action == "OUT") {
      s->out = true;
      s->outTime = timestamp;
      s->outReason = reason;
    } else if (action == "IN") {
      s->out = false;
      s->outTime = "";
      s->outReason = "";
    }
  }

  f.close();
}

