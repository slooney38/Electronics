void saveOptions() {
  if (server.hasArg("timeout")) {
    long value = server.arg("timeout").toInt();
    if (value >= 1000 && value <= 10000 && value % 1000 == 0) {
      reasonTimeoutMs = (unsigned long)value;
    }
  }
  if (server.hasArg("brightness")) {
    int value = server.arg("brightness").toInt();
    if (value >= 0 && value <= 255) ledBrightness = (uint8_t)value;
  }
  if (server.hasArg("scanconfirm")) {
    int value = server.arg("scanconfirm").toInt();
    if (value >= 0 && value <= 5) scanConfirmationSeconds = (uint8_t)value;
  }

  settingsPrefs.begin("classscan", false);
  settingsPrefs.putULong("timeout", reasonTimeoutMs);
  settingsPrefs.putUChar("brightness", ledBrightness);
  settingsPrefs.putUChar("scanconfirm", scanConfirmationSeconds);
  settingsPrefs.end();

  ledStrip.setBrightness(ledBrightness);
  updateLedStrip();
  String h = pageStart("Device Options Saved");
  h += "<div class='card'><h2>Options Saved</h2>";
  h += "<p>Reason timeout: " + String(reasonTimeoutMs / 1000) + " seconds</p>";
  h += "<p>LED brightness: " + String(ledBrightness) + " / 255</p>";
