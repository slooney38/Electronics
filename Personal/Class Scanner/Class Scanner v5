void handleRoot() {
  String h = pageStart("Dashboard", true);

  int outCount = 0;
  for (int i = 0; i < studentCount; i++) {
    if (students[i].out) outCount++;
  }

  h += "<div class='card'><h2>Dashboard</h2>";
  h += "<p><b>Students loaded:</b> " + String(studentCount) + "</p>";
  h += "<p><b>Students currently OUT:</b> " + String(outCount) + "</p>";
  h += "<p><b>Last scan:</b> " + esc(lastScan) + "</p>";
  h += "<p><b>Last scan time:</b> " + esc(lastTime) + "</p>";
  h += "<p>Page refreshes every 15 seconds.</p></div>";

  h += "<div class='card'><h2>Students Currently Out</h2>";

  if (outCount == 0) {
    h += "<p>No students are currently out.</p>";
  } else {
    h += "<table><tr><th>Pupil#</th><th>Student</th>";
    h += "<th>Time Out</th><th>Duration</th></tr>";

    time_t now = time(nullptr);

    for (int i = 0; i < studentCount; i++) {
      if (!students[i].out) continue;

      time_t start = timestampToEpoch(students[i].outTime);
      long elapsed = (start > 0 && now >= start)
                     ? (long)(now - start) : 0;

      h += "<tr><td>" + esc(students[i].id) + "</td>";
      h += "<td>" + esc(students[i].first) + " ";
      h += esc(students[i].last) + "</td>";
      h += "<td>" + esc(getClockTime(students[i].outTime)) + "</td>";
      h += "<td class='out'>" + formatDuration(elapsed) + "</td></tr>";
    }

    h += "</table>";
  }

  h += "</div>" + pageEnd();
  server.send(200, "text/html; charset=utf-8", h);
}

