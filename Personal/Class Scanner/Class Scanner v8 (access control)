void showClearCardLinks() {
  String h = pageStart("Clear Artona Card Links");
  h += "<div class='card'><h2>Clear Artona Card Links</h2>";
  h += "<p>This clears Artona IDs from the student CSV. It does not delete the student list or attendance logs.</p>";
