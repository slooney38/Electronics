  h += "<p><a href='/student-management'>Cancel and return to Student Management</a></p></div>" + pageEnd();
  server.send(200, "text/html; charset=utf-8", h);
}

void doClearCardLinks() {
  for (int i = 0; i < studentCount; i++) students[i].artonaId = "";
  File out = SPIFFS.open("/students.tmp", FILE_WRITE);
  bool ok = (bool)out;
  if (out) {
    out.println("Pupil#,UsualFirst,UsualLast,ArtonaID");
    for (int i = 0; i < studentCount; i++) {
      out.print(students[i].id); out.print(',');
      out.print(students[i].first); out.print(',');
      out.print(students[i].last); out.println(',');
    }
    out.close();
    SPIFFS.remove("/students.csv");
    ok = SPIFFS.rename("/students.tmp", "/students.csv");
  }
  String h = pageStart(ok ? "Artona Card Links Cleared" : "Could Not Clear Card Links");
  if (ok) {
    h += "<div class='card'><h2>Artona Card Links Cleared</h2>";
    h += "<p>Artona IDs were cleared from the student CSV. The student list and attendance logs are unchanged.</p>";
  } else {
    h += "<div class='card'><h2>Could Not Clear Card Links</h2>";
    h += "<p>The student CSV could not be rewritten. Please try again.</p>";
  }
  h += "<p><a href='/student-management'>Return to Student Management</a></p></div>" + pageEnd();
  server.send(ok ? 200 : 500, "text/html; charset=utf-8", h);
}

