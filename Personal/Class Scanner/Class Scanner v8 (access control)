// ======================================================
// STUDENT LOOKUP AND CSV LOADING
// ======================================================

Student* findStudent(String id) {
  id.trim();

  for (int i = 0; i < studentCount; i++) {
    if (students[i].id == id) return &students[i];
  }

  return nullptr;
}

void loadStudents() {
  studentCount = 0;

  if (!SPIFFS.exists("/students.csv")) {
    Serial.println("No students.csv found");
    return;
  }

  File f = SPIFFS.open("/students.csv", FILE_READ);
  if (!f) return;

  f.readStringUntil('\n');

  while (f.available() && studentCount < MAX_STUDENTS) {
    String line = f.readStringUntil('\n');
    line.trim();

    if (line.length() == 0) continue;

    int p1 = line.indexOf(',');
    int p2 = line.indexOf(',', p1 + 1);

    if (p1 < 0 || p2 < 0) continue;

    String id = line.substring(0, p1);
    String first = line.substring(p1 + 1, p2);
    int p3 = line.indexOf(',', p2 + 1);
    String last = (p3 >= 0) ? line.substring(p2 + 1, p3) : line.substring(p2 + 1);
    String artona = (p3 >= 0) ? line.substring(p3 + 1) : "";

    id.trim();
    first.trim();
    last.trim();
    artona.trim();

    if (id.length() == 0) continue;

    bool duplicate = false;

    for (int i = 0; i < studentCount; i++) {
      if (students[i].id == id) {
        duplicate = true;
        break;
      }
    }

    if (duplicate) continue;

    students[studentCount].id = id;
    students[studentCount].first = first;
    students[studentCount].last = last;
    students[studentCount].artonaId = artona;
    students[studentCount].out = false;
    students[studentCount].outTime = "";
    students[studentCount].outReason = "";
    studentCount++;
  }

  f.close();

  Serial.print("Students loaded: ");
  Serial.println(studentCount);
}

