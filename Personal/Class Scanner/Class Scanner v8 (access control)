// ======================================================
// SETUP
// ======================================================

void setup() {
  Serial.begin(115200);
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(SCANNER_TRIGGER_PIN, OUTPUT_OPEN_DRAIN);
  digitalWrite(SCANNER_TRIGGER_PIN, HIGH); // released / high impedance

  for (int led = 0; led < LED_COUNT; led++) {
    ledStudentIndex[led] = -1;
  }

  ledStrip.begin();
  settingsPrefs.begin("classscan", true);
  SCHOOL_SSID = settingsPrefs.getString("schoolssid", SCHOOL_SSID);
  SCHOOL_PASS = settingsPrefs.getString("schoolpass", SCHOOL_PASS);
  AP_SSID = settingsPrefs.getString("apssid", AP_SSID);
  AP_PASS = settingsPrefs.getString("appass", AP_PASS);
  guiAuthEnabled = settingsPrefs.getBool("guiauth", false);
  guiAuthUser = settingsPrefs.getString("guiuser", "admin");
  guiAuthPass = settingsPrefs.getString("guipass", "");
  if (guiAuthUser.length() == 0 || guiAuthPass.length() == 0) guiAuthEnabled = false;
  reasonTimeoutMs = settingsPrefs.getULong("timeout", 3000);
  scannerWindowMs = settingsPrefs.getULong("scandelay", 15000);
  if (scannerWindowMs != 10000UL && scannerWindowMs != 15000UL && scannerWindowMs != 20000UL && scannerWindowMs != 25000UL && scannerWindowMs != 30000UL) scannerWindowMs = 15000UL;
  if (reasonTimeoutMs < 1000 || reasonTimeoutMs > 10000) reasonTimeoutMs = 3000;
  ledBrightness = settingsPrefs.getUChar("brightness", 50);
  scanConfirmationSeconds = settingsPrefs.getUChar("scanconfirm", 2);
  if (scanConfirmationSeconds > 5) scanConfirmationSeconds = 2;
  settingsPrefs.end();

  ledStrip.setBrightness(ledBrightness);
  ledStrip.clear();
  ledStrip.show();

  Wire.begin(21, 22);

  if (oled.begin(0x3C, true)) {
    oledReady = true;
    oled.clearDisplay();
    oled.setTextColor(SH110X_WHITE);
    oled.setTextSize(1);
    oled.setCursor(0, 0);
    oled.println("Class Scanner");
    oled.println("Starting...");
    oled.display();

    Serial.println("SH1106 OLED ready at 0x3C");
  } else {
    Serial.println("SH1106 OLED not found at 0x3C");
  }

  scanner.begin(9600, SERIAL_8N1, 16, 17);

  if (!SPIFFS.begin(true)) {
    Serial.println("SPIFFS mount failed");
    return;
  }

  initLogs();
  loadStudents();

  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID.c_str(), AP_PASS.c_str());

  Serial.print("AP IP: ");
  Serial.println(WiFi.softAPIP());

  WiFi.begin(SCHOOL_SSID.c_str(), SCHOOL_PASS.c_str());

  Serial.println("Connecting to school WiFi...");
  unsigned long started = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - started < 15000) {
    delay(250);
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("School WiFi IP: ");
    Serial.println(WiFi.localIP());

    configTime(-8 * 3600, 3600,
               "pool.ntp.org", "time.nist.gov");

    struct tm ti;

    if (getLocalTime(&ti, 10000)) {
      Serial.println("Time synchronized");
    } else {
      Serial.println("NTP not available yet");
    }
  } else {
    Serial.println("School WiFi unavailable; AP is still active");
  }

  restoreAttendanceState();

  reasonMenuVisible = false;
  updateOledDisplay(true);
  lastOledUpdate = millis();

  updateLedStrip();

  server.on("/", HTTP_GET, [](){ if (requireGuiAuth()) handleRoot(); });
  server.on("/upload", HTTP_GET, [](){ if (requireGuiAuth()) showUploadPage(); });
  server.on("/students", HTTP_GET, [](){ if (requireGuiAuth()) showStudents(); });
  server.on("/student-management", HTTP_GET, [](){ if (requireGuiAuth()) showStudentManagement(); });
  server.on("/attendance-reports", HTTP_GET, [](){ if (requireGuiAuth()) showAttendanceReports(); });
  server.on("/logs", HTTP_GET, [](){ if (requireGuiAuth()) handleLogs(); });
  server.on("/report", HTTP_GET, [](){ if (requireGuiAuth()) handleReport(); });
  server.on("/options", HTTP_GET, [](){ if (requireGuiAuth()) showOptions(); });
  server.on("/options", HTTP_POST, [](){ if (requireGuiAuth()) saveOptions(); });
  server.on("/clearstudents", HTTP_GET, [](){ if (requireGuiAuth()) showClearStudents(); });
  server.on("/clearstudents", HTTP_POST, [](){ if (requireGuiAuth()) doClearStudents(); });
  server.on("/clearcardlinks", HTTP_GET, [](){ if (requireGuiAuth()) showClearCardLinks(); });
  server.on("/clearcardlinks", HTTP_POST, [](){ if (requireGuiAuth()) doClearCardLinks(); });
  server.on("/clearlogs", HTTP_GET, [](){ if (requireGuiAuth()) showClearLogs(); });
  server.on("/clearlogs", HTTP_POST, [](){ if (requireGuiAuth()) doClearLogs(); });

  server.on("/upload", HTTP_POST,
    [](){ if (requireGuiAuth()) handleUploadComplete(); },
    [](HTTPUpload &upload){ if (requireGuiAuth()) handleUploadData(); }
  );

  server.begin();

  Serial.println("Web server ready");
  Serial.println("Open http://192.168.4.1/");
}

// ======================================================
// MAIN LOOP
// ======================================================

void startScannerWindow() {
  if (scannerActive) return;
  scannerActive = true;
  scannerStartTime = millis();
  digitalWrite(SCANNER_TRIGGER_PIN, LOW); // simulate scanner button pressed
  Serial.printf("Scanner active (%lu-second window)\n", scannerWindowMs / 1000UL);
}

void stopScannerWindow() {
  if (!scannerActive) return;
  digitalWrite(SCANNER_TRIGGER_PIN, HIGH); // release to high impedance
  scannerActive = false;
  Serial.println("Scanner stopped");
}

void loop() {
  server.handleClient();

  // A fresh press on GPIO 25 starts a scanner window only from the start screen.
  bool scannerButtonReading = digitalRead(BUTTON_PIN);
  if (scannerButtonLastReading == HIGH && scannerButtonReading == LOW &&
      pendingOutStudentIndex < 0 && !registrationMode && !reasonMenuVisible &&
      !waitingToShowReason) {
    startScannerWindow();
  }
  scannerButtonLastReading = scannerButtonReading;

  if (scannerActive && millis() - scannerStartTime >= scannerWindowMs) {
    stopScannerWindow();
    updateOledDisplay(true);
  }

  handleReasonButton();
  updateOledDisplay();

  static unsigned long lastLedUpdate = 0;

  if (millis() - lastLedUpdate >= 100) {
    lastLedUpdate = millis();
    updateLedStrip();
  }

  if (scanner.available()) {
    String code = scanner.readStringUntil('\n');
    code.trim();
    if (code.length() > 0) processScannedCode(code);
  }
}
