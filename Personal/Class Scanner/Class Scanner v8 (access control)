    if (value.length() > 0 && value.length() <= 32) guiAuthUser = value;
  }
  if (server.hasArg("guipass")) {
    String value = server.arg("guipass");
    if (value.length() <= 64) guiAuthPass = value;
  }
  if (guiAuthEnabled && (guiAuthUser.length() == 0 || guiAuthPass.length() == 0)) {
    guiAuthEnabled = false;
  }
  if (server.hasArg("schoolssid")) {
    String value = server.arg("schoolssid"); value.trim();
    if (value.length() > 0 && value.length() <= 32) { SCHOOL_SSID = value; wifiSettingsChanged = true; }
  }
  if (server.hasArg("schoolpass")) {
    String value = server.arg("schoolpass");
    if (value.length() <= 64) { SCHOOL_PASS = value; wifiSettingsChanged = true; }
  }
  if (server.hasArg("apssid")) {
    String value = server.arg("apssid"); value.trim();
    if (value.length() > 0 && value.length() <= 32) { AP_SSID = value; wifiSettingsChanged = true; }
  }
  if (server.hasArg("appass")) {
    String value = server.arg("appass");
    if (value.length() >= 8 && value.length() <= 63) { AP_PASS = value; wifiSettingsChanged = true; }
  }

  settingsPrefs.begin("classscan", false);
  settingsPrefs.putString("schoolssid", SCHOOL_SSID);
  settingsPrefs.putString("schoolpass", SCHOOL_PASS);
  settingsPrefs.putString("apssid", AP_SSID);
  settingsPrefs.putString("appass", AP_PASS);
  settingsPrefs.putBool("guiauth", guiAuthEnabled);
  settingsPrefs.putString("guiuser", guiAuthUser);
  settingsPrefs.putString("guipass", guiAuthPass);
  settingsPrefs.putULong("timeout", reasonTimeoutMs);
  settingsPrefs.putULong("scandelay", scannerWindowMs);
  settingsPrefs.putUChar("brightness", ledBrightness);
  settingsPrefs.putUChar("scanconfirm", scanConfirmationSeconds);
  settingsPrefs.end();

  ledStrip.setBrightness(ledBrightness);
  updateLedStrip();
  String h = pageStart("Device Options Saved");
  h += "<div class='card'><h2>Options Saved</h2>";
  h += "<p>School Wi-Fi SSID: " + schoolSsidHtml(SCHOOL_SSID) + "</p>";
  h += "<p>ClassScanner access point SSID: " + schoolSsidHtml(AP_SSID) + "</p>";
  h += String("<p>Web GUI login: ") + (guiAuthEnabled ? "Enabled</p>" : "Disabled</p>");
  h += wifiSettingsChanged ? "<p>Wi-Fi settings saved. Restart the ESP32 to apply network changes.</p>" : "";
  h += "<p>Scanner delay: " + String(scannerWindowMs / 1000) + " seconds</p>";
  h += "<p>Reason timeout: " + String(reasonTimeoutMs / 1000) + " seconds</p>";
  h += "<p>LED brightness: " + String(ledBrightness) + " / 255</p>";
  h += "<p>Scan confirmation display: " + String(scanConfirmationSeconds) + (scanConfirmationSeconds == 1 ? " second</p>" : " seconds</p>");
  h += "<p><a href='/options'>Back to Device Options</a></p></div>" + pageEnd();
  server.send(200, "text/html; charset=utf-8", h);
}

