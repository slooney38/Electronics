void showReasonMenu() {
  if (!oledReady) return;

  oled.clearDisplay();
  oled.setTextColor(SH110X_WHITE);
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.println("REASON FOR LEAVE");
  oled.drawLine(0, 9, 127, 9, SH110X_WHITE);

  // Include a final Back option so a scan can be cancelled before checkout.
  for (int i = 0; i <= REASON_COUNT; i++) {
    int rowY = 18 + i * 8;
    oled.setCursor(0, rowY);
    oled.print(i == selectedReason ? "> " : "  ");
    if (i < REASON_COUNT) {
      oled.print(REASONS[i]);
    } else {
      // Draw a left-pointing arrow, then label the option Back.
      oled.drawLine(14, rowY + 3, 20, rowY + 3, SH110X_WHITE);
      oled.drawLine(14, rowY + 3, 17, rowY, SH110X_WHITE);
      oled.drawLine(14, rowY + 3, 17, rowY + 6, SH110X_WHITE);
      oled.setCursor(24, rowY);
      oled.print("Back");
    }
  }

  oled.drawLine(0, 43, 127, 43, SH110X_WHITE);
  if (selectedReason < 0) {
    oled.setCursor(0, 49);
    oled.print("Tap to select reason");
  } else {
    // Visual 3-second countdown bar. It fills as the deadline approaches.
    oled.setCursor(0, 45);
    oled.print("Entering...");

    const int barX = 4;
    const int barY = 55;
    const int barW = 120;
    const int barH = 7;
    oled.drawRect(barX, barY, barW, barH, SH110X_WHITE);

    unsigned long now = millis();
    unsigned long remaining = (long)(reasonSelectionDeadline - now) > 0
                              ? reasonSelectionDeadline - now : 0;
    unsigned long elapsed = reasonTimeoutMs - min((unsigned long)reasonTimeoutMs, remaining);
    int innerW = barW - 4;
    int fillW = (int)((elapsed * (unsigned long)innerW) / reasonTimeoutMs);
    if (fillW > 0) {
      oled.fillRect(barX + 2, barY + 2, fillW, barH - 4, SH110X_WHITE);
    }
  }
  oled.display();
}

