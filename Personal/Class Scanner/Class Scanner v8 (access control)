void handleUploadData() {
  HTTPUpload& u = server.upload();

  if (u.status == UPLOAD_FILE_START) {
    uploadOK = false;

    if (!u.filename.endsWith(".csv")) {
      Serial.println("Upload rejected: filename must end in .csv");
      return;
    }

    uploadFile = SPIFFS.open("/students.tmp", FILE_WRITE);

    if (!uploadFile) {
      Serial.println("Could not create temporary upload file");
    }
  }
  else if (u.status == UPLOAD_FILE_WRITE) {
    if (uploadFile) {
      size_t written = uploadFile.write(u.buf, u.currentSize);

      if (written != u.currentSize) {
        Serial.println("Upload write error");
      }
    }
  }
  else if (u.status == UPLOAD_FILE_END) {
    if (uploadFile) {
      uploadFile.close();

      File check = SPIFFS.open("/students.tmp", FILE_READ);

      String normalized = "Pupil#,UsualFirst,UsualLast,ArtonaID\n";
      bool headerOK = false;
      bool hasFourthColumn = false;
      if (check && check.size() > 0) {
        String header = check.readStringUntil('\n');
        header.trim();
        headerOK = (header == "Pupil#,UsualFirst,UsualLast" || header == "Pupil#,UsualFirst,UsualLast,ArtonaID");
        hasFourthColumn = (header == "Pupil#,UsualFirst,UsualLast,ArtonaID");
        while (headerOK && check.available()) {
          String line = check.readStringUntil('\n');
          line.trim();
          if (line.length() == 0) continue;
          int p1 = line.indexOf(',');
          int p2 = (p1 >= 0) ? line.indexOf(',', p1 + 1) : -1;
          if (p1 < 0 || p2 < 0) { headerOK = false; break; }
          int p3 = line.indexOf(',', p2 + 1);
          String pupil = line.substring(0, p1); pupil.trim();
          String first = line.substring(p1 + 1, p2); first.trim();
          String last = (p3 >= 0) ? line.substring(p2 + 1, p3) : line.substring(p2 + 1); last.trim();
          String token = (hasFourthColumn && p3 >= 0) ? line.substring(p3 + 1) : "";
          token.trim();
          if (!hasFourthColumn) {
            for (int i = 0; i < studentCount; i++) {
              if (students[i].id == pupil) { token = students[i].artonaId; break; }
            }
          }
          normalized += pupil + "," + first + "," + last + "," + token + "\n";
        }
      }
      if (check) check.close();

      if (headerOK) {
        File norm = SPIFFS.open("/students.normalized", FILE_WRITE);
        if (norm) {
          uploadOK = (norm.print(normalized) == normalized.length());
          norm.close();
        }
        if (uploadOK) {
          SPIFFS.remove("/students.csv");
          uploadOK = SPIFFS.rename("/students.normalized", "/students.csv");
        }
      } else uploadOK = false;

      if (!uploadOK) {
        SPIFFS.remove("/students.tmp");
        SPIFFS.remove("/students.normalized");
        Serial.println("Student CSV upload rejected or could not be saved.");
      } else {
        SPIFFS.remove("/students.tmp");
      }
    }
  }
  else if (u.status == UPLOAD_FILE_ABORTED) {
    if (uploadFile) uploadFile.close();
    SPIFFS.remove("/students.tmp");
    uploadOK = false;
  }
}

