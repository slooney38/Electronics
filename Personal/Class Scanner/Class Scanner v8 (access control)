}

void logEvent(Student* s, String action, String timestamp, String reason) {
  File f = SPIFFS.open("/logs.csv", FILE_APPEND);

  if (!f) {
    Serial.println("ERROR: Cannot write logs.csv");
    return;
  }

  f.print(timestamp);
  f.print(",");
  f.print(s->id);
  f.print(",");
  f.print(s->first);
  f.print(",");
  f.print(s->last);
  f.print(",");
  f.print(action);
  f.print(",");

  if (action == "OUT") {
    f.println(reason);
  } else {
    f.println(s->outReason);
  }

  f.close();
}

void restoreAttendanceState() {
  if (!SPIFFS.exists("/logs.csv")) return;

  File f = SPIFFS.open("/logs.csv", FILE_READ);
  if (!f) return;

  f.readStringUntil('\n');

  while (f.available()) {
    String line = f.readStringUntil('\n');
    line.trim();

    if (line.length() == 0) continue;

    int p1 = line.indexOf(',');
    int p2 = line.indexOf(',', p1 + 1);
    int p3 = line.indexOf(',', p2 + 1);
    int p4 = line.indexOf(',', p3 + 1);

    if (p1 < 0 || p2 < 0 || p3 < 0 || p4 < 0) continue;

    String id = line.substring(p1 + 1, p2);
    String timestamp = line.substring(0, p1);
    String tail = line.substring(p4 + 1);

    int p5 = tail.indexOf(',');
    String action = (p5 >= 0) ? tail.substring(0, p5) : tail;
    String reason = (p5 >= 0) ? tail.substring(p5 + 1) : "Washroom";

    action.trim();
    reason.trim();

    Student* s = findStudent(id);
    if (!s) continue;

    if (action == "OUT") {
      s->out = true;
      s->outTime = timestamp;
      s->outReason = reason;
    } else if (action == "IN") {
      s->out = false;
      s->outTime = "";
      s->outReason = "";
    }
  }

  f.close();
}

