String extractArtonaId(String code) {
  code.trim();
  int q = code.indexOf("id=");
  if (q < 0) return "";
  String id = code.substring(q + 3);
  int amp = id.indexOf('&');
  if (amp >= 0) id = id.substring(0, amp);
  id.trim();
  // The expected Artona token is a compact hexadecimal-like identifier.
  if (id.length() == 0 || id.length() > 64) return "";
  for (unsigned int i = 0; i < id.length(); i++) {
    char c = id[i];
    if (!isAlphaNumeric(c) && c != '-' && c != '_') return "";
  }
  return id;
}

String findPupilForArtonaId(String token) {
  for (int i = 0; i < studentCount; i++) {
    if (students[i].artonaId == token && token.length() > 0) return students[i].id;
  }
  return "";
}

bool saveCardLink(String pupilId, String token) {
  Student* target = findStudent(pupilId);
  if (!target || token.length() == 0) return false;

  // Keep each Artona token unique: clear it from any other pupil first.
  for (int i = 0; i < studentCount; i++) {
    if (students[i].artonaId == token || students[i].id == pupilId) {
      students[i].artonaId = "";
    }
  }
  target = findStudent(pupilId);
  if (!target) return false;
  target->artonaId = token;

  File out = SPIFFS.open("/students.tmp", FILE_WRITE);
  if (!out) return false;
  out.println("Pupil#,UsualFirst,UsualLast,ArtonaID");
  for (int i = 0; i < studentCount; i++) {
    out.print(students[i].id); out.print(',');
    out.print(students[i].first); out.print(',');
    out.print(students[i].last); out.print(',');
    out.println(students[i].artonaId);
  }
  out.close();
  SPIFFS.remove("/students.csv");
  if (!SPIFFS.rename("/students.tmp", "/students.csv")) return false;
  return true;
}

void processScannedCode(String code) {
  stopScannerWindow();
  code.trim();
  if (code.length() == 0) return;
  // A new scan counts as input and restarts the idle timer while registering.
  if (registrationMode) inputIdleDeadline = millis() + INPUT_IDLE_TIMEOUT_MS;

  if (registrationMode) {
    if (registrationStep == 1) {
      // The Artona QR was scanned first. Now scan the pupil number to link it.
      Student* pupil = findStudent(code);
      if (!pupil) {
        lastScan = "Unknown pupil ID";
        scanMessage = "Not in student list";
        Serial.println("Registration failed: pupil number not found in students.csv");
        showRegistrationPrompt();
        return;
      }

      registrationPupilId = pupil->id;
      bool ok = saveCardLink(registrationPupilId, pendingArtonaId);
      oled.clearDisplay();
      oled.setTextColor(SH110X_WHITE);
      oled.setTextSize(1);
      oled.setCursor(0, 0);
      oled.println(ok ? "CARD LINK SAVED" : "SAVE FAILED");
      oled.setCursor(0, 20);
      oled.println(registrationPupilId);
      oled.setCursor(0, 36);
      oled.println(ok ? "Registration done" : "Check SPIFFS");
      oled.display();
      Serial.println(ok ? "Artona card link saved." : "Could not save Artona card link.");
      registrationMode = false;
      registrationStep = 0;
      inputIdleDeadline = 0;
      registrationPupilId = "";
      pendingArtonaId = "";
      lastOledUpdate = millis();
      return;
    }
  }

  // Normal scans can be either a pupil number or an Artona QR URL/token.
  if (code.startsWith("http://") || code.startsWith("https://")) {
    String token = extractArtonaId(code);
    if (token.length() == 0) {
      lastScan = "Unrecognized QR URL";
      lastTime = getTimestamp();
      updateOledDisplay(true);
      return;
    }
    String pupilId = findPupilForArtonaId(token);
    if (pupilId.length() == 0) {
      // Automatically begin registration when an unknown Artona QR is scanned.
      pendingArtonaId = token;
      registrationPupilId = "";
      registrationMode = true;
      registrationStep = 1;
      inputIdleDeadline = millis() + INPUT_IDLE_TIMEOUT_MS;
      scanMessageUntil = 0;
      reasonMenuVisible = false;
      lastScan = "Register Artona card";
      lastTime = getTimestamp();
      Serial.println("Unregistered Artona QR detected. Scan the student's school ID next.");
      showRegistrationPrompt();
      return;
    }
    code = pupilId;
  }

  // Do not accept another scan while a student is choosing a reason.
  if (pendingOutStudentIndex >= 0) {
    Serial.println("Choose a reason and hold the button to confirm first.");
    return;
  }

  Student* s = findStudent(code);
  if (!s) {
    lastScan = "Unknown Student: " + code;
    lastTime = getTimestamp();
    Serial.println(lastScan);
    scanMessage = "Unknown student";
    scanMessageUntil = millis() + 2000UL;
    updateOledDisplay(true);
    return;
  }

  // Confirm a recognized student scan with one brief all-green flash.
  flashSuccessfulScan();

  if (!s->out) {
    pendingOutStudentIndex = (int)(s - students);
    inputIdleDeadline = millis() + INPUT_IDLE_TIMEOUT_MS;
    selectedReason = -1;
    reasonSelectionDeadline = 0;
    scanStudentName = s->first + " " + s->last;
    scanStudentId = s->id;
    scanMessage = "";
    waitingToShowReason = scanConfirmationSeconds > 0;
    scanMessageUntil = waitingToShowReason
      ? millis() + (unsigned long)scanConfirmationSeconds * 1000UL : 0;
    reasonMenuVisible = !waitingToShowReason;
    lastOledUpdate = millis();
    if (waitingToShowReason) showScanMessage();
    else showReasonMenu();
    Serial.print("Reason required for: ");
    Serial.println(s->first + " " + s->last);
    return;
  }

  String timestamp = getTimestamp();
  s->out = false;
  String reasonForLog = s->outReason;
  s->outTime = "";
  logEvent(s, "IN", timestamp, reasonForLog);
  lastScan = s->first + " " + s->last + " (IN)";
  lastTime = timestamp;
  Serial.println(lastScan);
  scanMessage = "IN recorded";
  scanStudentName = s->first + " " + s->last;
  scanStudentId = s->id;
  scanMessageUntil = scanConfirmationSeconds > 0 ? millis() + (unsigned long)scanConfirmationSeconds * 1000UL : 0;
  reasonMenuVisible = false;
  updateOledDisplay(true);
  updateLedStrip();
}

void handleReasonButton() {
  bool reading = digitalRead(BUTTON_PIN);

  if (reading != buttonLastReading) {
    buttonLastChange = millis();
    buttonLastReading = reading;
  }

  if (millis() - buttonLastChange >= BUTTON_DEBOUNCE_MS &&
      reading != buttonStableState) {
    buttonStableState = reading;
    if (buttonStableState == LOW) {
      buttonPressedAt = millis();
      longPressHandled = false;
    } else {
      // Short press is handled on release. A long press has already started registration.
      if (!longPressHandled && pendingOutStudentIndex >= 0 && !waitingToShowReason) {
        inputIdleDeadline = 0; // Student interacted; normal reason-selection timer now applies.
        if (selectedReason < 0) selectedReason = 0;
        else selectedReason = (selectedReason + 1) % (REASON_COUNT + 1);
        reasonSelectionDeadline = millis() + reasonTimeoutMs;
        showReasonMenu();
        lastOledUpdate = millis();
      } else if (!longPressHandled && pendingOutStudentIndex < 0 && !registrationMode) {
        reasonMenuVisible = false;
        updateOledDisplay(true);
      }
    }
  }

  // Preserve long-press suppression for the reason button, but registration is
  // now triggered automatically by scanning an unregistered Artona QR.
  if (buttonStableState == LOW && !longPressHandled &&
      millis() - buttonPressedAt >= 1800UL) {
    longPressHandled = true;
  }
}

void updateOledDisplay(bool force) {
  if (!oledReady) return;

  unsigned long nowMs = millis();

  // If a scan requires follow-up input and there is none for 30 seconds,
  // cancel the pending action and return to the normal starting screen.
  if (inputIdleDeadline != 0 && (long)(nowMs - inputIdleDeadline) >= 0) {
    inputIdleDeadline = 0;
    registrationMode = false;
    registrationStep = 0;
    registrationPupilId = "";
    pendingArtonaId = "";
    pendingOutStudentIndex = -1;
    selectedReason = -1;
    reasonSelectionDeadline = 0;
    reasonMenuVisible = false;
    waitingToShowReason = false;
    scanMessageUntil = 0;
    scanMessage = "";
    lastScan = "Input timed out";
    lastTime = getTimestamp();
    updateOledDisplay(true);
    return;
  }

  // Keep the registration prompts visible until registration finishes or is cancelled.
  if (registrationMode) return;

  // For an OUT scan, show the student's name and ID first, then the reason menu.
  if (pendingOutStudentIndex >= 0 && waitingToShowReason) {
    if (scanConfirmationSeconds > 0 && scanMessageUntil != 0 &&
        (long)(nowMs - scanMessageUntil) < 0) {
      if (force || nowMs - lastOledUpdate >= OLED_REFRESH_MS) {
        lastOledUpdate = nowMs;
        showScanMessage();
      }
      return;
    }
    waitingToShowReason = false;
    scanMessageUntil = 0;
    reasonMenuVisible = true;
    lastOledUpdate = nowMs;
    showReasonMenu();
    return;
  }

  // A selected reason is automatically recorded after the visible countdown.
  if (pendingOutStudentIndex >= 0) {
    if (selectedReason >= 0 && reasonSelectionDeadline != 0 &&
        (long)(nowMs - reasonSelectionDeadline) >= 0) {
      finishPendingOut();
      return;
    }
    // Refresh the progress bar frequently so it visibly advances smoothly.
    if (force || nowMs - lastOledUpdate >= 100UL) {
      lastOledUpdate = nowMs;
      showReasonMenu();
    }
    return;
  }

  if (scanMessageUntil != 0 && nowMs < scanMessageUntil) {
    if (force || nowMs - lastOledUpdate >= OLED_REFRESH_MS) {
      lastOledUpdate = nowMs;
      showScanMessage();
    }
    return;
  }

  if (scanMessageUntil != 0 && nowMs >= scanMessageUntil) {
    scanMessageUntil = 0;
  }

  if (!force && nowMs - lastOledUpdate < OLED_REFRESH_MS) return;
  lastOledUpdate = nowMs;

  int outCount = 0;
  for (int i = 0; i < studentCount; i++) {
    if (students[i].out) outCount++;
  }

  oled.clearDisplay();
  oled.setTextColor(SH110X_WHITE);
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.print("STUDENTS OUT: ");
  oled.print(outCount);
  oled.drawLine(0, 10, 127, 10, SH110X_WHITE);

  if (outCount == 0) {
    oled.setCursor(0, 25);
    oled.print("Scan Student ID");
    oled.setCursor(0, 40);
    oled.print("to begin");
    oled.display();
    return;
  }

  const int namesPerPage = 4;
  int pageCount = (outCount + namesPerPage - 1) / namesPerPage;
  int page = (nowMs / OLED_PAGE_MS) % pageCount;
  int firstOutIndex = page * namesPerPage;
  int currentOutIndex = 0;
  int displayed = 0;
  time_t nowEpoch = time(nullptr);

  for (int i = 0; i < studentCount && displayed < namesPerPage; i++) {
    if (!students[i].out) continue;
    if (currentOutIndex >= firstOutIndex) {
      String name = students[i].first + " " + students[i].last;
      time_t outEpoch = timestampToEpoch(students[i].outTime);
      long elapsedMinutes =
        (outEpoch > 0 && nowEpoch >= outEpoch)
        ? (long)(nowEpoch - outEpoch) / 60L : 0L;
      String duration = String(elapsedMinutes) + "m";
      int maxNameLength = 21 - duration.length() - 2;
      if (maxNameLength < 1) maxNameLength = 1;
      if ((int)name.length() > maxNameLength) name = name.substring(0, maxNameLength);
      oled.setCursor(0, 13 + displayed * 12);
      oled.print(name);
      oled.print("  ");
      oled.print(duration);
      displayed++;
    }
    currentOutIndex++;
  }

  if (pageCount > 1) {
    oled.setCursor(94, 55);
    oled.print(String(page + 1) + "/" + String(pageCount));
  }
  oled.display();
}

// ======================================================
// TIME FUNCTIONS
// ======================================================

String getTimestamp() {
  struct tm ti;

  if (!getLocalTime(&ti, 1000)) {
    return "No Time";
  }

  char buf[24];
  strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &ti);
  return String(buf);
}

String getClockTime(String ts) {
  if (ts.length() >= 19) return ts.substring(11, 19);
  return "--:--:--";
}

time_t timestampToEpoch(String ts) {
  int y, mo, d, h, mi, s;

  if (sscanf(ts.c_str(), "%d-%d-%d %d:%d:%d",
             &y, &mo, &d, &h, &mi, &s) != 6) {
    return 0;
  }

  struct tm ti = {};
  ti.tm_year = y - 1900;
  ti.tm_mon = mo - 1;
  ti.tm_mday = d;
  ti.tm_hour = h;
  ti.tm_min = mi;
  ti.tm_sec = s;
  ti.tm_isdst = -1;

  return mktime(&ti);
}

String formatDuration(long seconds) {
  if (seconds < 0) seconds = 0;

  long minutes = seconds / 60;
  long hours = minutes / 60;
  minutes %= 60;

  if (hours > 0) {
    return String(hours) + " hr " + String(minutes) + " min";
  }

  return String(minutes) + " min";
}

long minutesBetween(String start, String finish) {
  time_t a = timestampToEpoch(start);
  time_t b = timestampToEpoch(finish);

  if (a == 0 || b == 0 || b < a) return 0;
  return (long)(b - a) / 60;
}

// ======================================================
// LED STRIP
// Green: under 5 min
// Orange: 5 to under 10 min
// Solid red: 10 to under 15 min
// Blinking red: 15 min or longer
// ======================================================

int findLedForStudent(int studentIndex) {
  for (int led = 0; led < LED_COUNT; led++) {
    if (ledStudentIndex[led] == studentIndex) return led;
  }

  return -1;
}

void updateLedAssignments() {
  for (int led = 0; led < LED_COUNT; led++) {
    int idx = ledStudentIndex[led];

    if (idx < 0 || idx >= studentCount || !students[idx].out) {
      ledStudentIndex[led] = -1;
    }
  }

  for (int i = 0; i < studentCount; i++) {
    if (!students[i].out || findLedForStudent(i) >= 0) continue;

    for (int led = 0; led < LED_COUNT; led++) {
      if (ledStudentIndex[led] < 0) {
        ledStudentIndex[led] = i;
        break;
      }
    }
  }
}

void flashSuccessfulScan() {
  // One short green flash across the entire strip, then restore status colors.
  for (int led = 0; led < LED_COUNT; led++) {
    ledStrip.setPixelColor(led, ledStrip.Color(0, 255, 0));
  }
  ledStrip.show();
  delay(300);
  updateLedStrip();
}

void updateLedStrip() {
  updateLedAssignments();
  time_t now = time(nullptr);

  for (int led = 0; led < LED_COUNT; led++) {
    uint32_t color = ledStrip.Color(0, 0, 0);
    int idx = ledStudentIndex[led];

    if (idx >= 0 && idx < studentCount && students[idx].out) {
      time_t start = timestampToEpoch(students[idx].outTime);

      long elapsedSeconds =
        (start > 0 && now >= start) ? (long)(now - start) : 0;

      if (elapsedSeconds < 5L * 60L) {
        color = ledStrip.Color(0, 255, 0);
      } else if (elapsedSeconds < 10L * 60L) {
        color = ledStrip.Color(255, 70, 0);
      } else if (elapsedSeconds < 15L * 60L) {
        color = ledStrip.Color(255, 0, 0);
      } else {
        color = (millis() % 1000UL < 500UL)
                ? ledStrip.Color(255, 0, 0)
                : ledStrip.Color(0, 0, 0);
      }
    }

